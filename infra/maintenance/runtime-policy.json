{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageIdentitySessions",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:000000000000:table/compound-sessions"
    },
    {
      "Sid": "CountLoginAttempts",
      "Effect": "Allow",
      "Action": "dynamodb:UpdateItem",
      "Resource": "arn:aws:dynamodb:us-east-1:000000000000:table/compound-login-limits"
    },
    {
      "Sid": "WriteMaintenanceLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-1:000000000000:log-group:/aws/lambda/compound-maintenance:*"
    },
    {
      "Sid": "ReadMaintenanceRuntimeSecret",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:us-east-1:000000000000:secret:compound/maintenance/runtime-??????"
    }
  ]
}
