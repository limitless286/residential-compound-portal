PORT=3003
DATABASE_URL="postgresql://community_app:YOUR_PASSWORD@YOUR_NEON_HOST/neondb?sslmode=verify-full&channel_binding=require"
AUTH_SERVICE_KEY=YOUR_SERVICE_KEY
SERVICE_NAME=community
IDENTITY_BASE_URL=http://127.0.0.1:3001
# Key maintenance uses to call community's internal draft endpoint.
# Must differ from AUTH_SERVICE_KEY and from maintenance's bookings key.
MAINTENANCE_AUTH_KEY=YOUR_MAINTENANCE_CALLER_KEY

